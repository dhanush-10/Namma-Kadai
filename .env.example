# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the "anon" / publishable key (safe for the browser — protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public URL of the deployed site (used in password-reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NOTE: do NOT add the service_role key anywhere in this project. The app never needs it.
